{
  "name": "@epfml/discojs",
  "version": "3.0.0",
  "type": "module",
  "exports": {
    ".": {
      "@disco/source": "./src/index.ts",
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "types": "dist/index.d.ts",
  "scripts": {
    "watch": "nodemon --ext ts --ignore dist --exec pnpm run",
    "build": "tsc --build tsconfig.lib.json",
    "test": "cd .. && vitest --run --project=discojs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/epfml/disco.git"
  },
  "bugs": {
    "url": "https://github.com/epfml/disco/issues"
  },
  "imports": {
    "#root/*": {
      "@disco/source": "./src/*.ts",
      "default": "./dist/*.js",
      "types": "./dist/*.d.ts"
    },
    "#aggregator/*": {
      "@disco/source": "./src/aggregator/*.ts",
      "default": "./dist/aggregator/*.js",
      "types": "./dist/aggregator/*.d.ts"
    },
    "#client/*": {
      "@disco/source": "./src/client/*.ts",
      "default": "./dist/client/*.js",
      "types": "./dist/client/*.d.ts"
    },
    "#dataset/*": {
      "@disco/source": "./src/dataset/*.ts",
      "default": "./dist/dataset/*.js",
      "types": "./dist/dataset/*.d.ts"
    },
    "#dtypes/*": {
      "@disco/source": "./src/types/*.ts",
      "default": "./dist/types/*.js",
      "types": "./dist/types/*.d.ts"
    },
    "#logging/*": {
      "@disco/source": "./src/logging/*.ts",
      "default": "./dist/logging/*.js",
      "types": "./dist/logging/*.d.ts"
    },
    "#models/*": {
      "@disco/source": "./src/models/*.ts",
      "default": "./dist/models/*.js",
      "types": "./dist/models/*.d.ts"
    },
    "#processing/*": {
      "@disco/source": "./src/processing/*.ts",
      "default": "./dist/processing/*.js",
      "types": "./dist/processing/*.d.ts"
    },
    "#serialization/*": {
      "@disco/source": "./src/serialization/*.ts",
      "default": "./dist/serialization/*.js",
      "types": "./dist/serialization/*.d.ts"
    },
    "#task/*": {
      "@disco/source": "./src/task/*.ts",
      "default": "./dist/task/*.js",
      "types": "./dist/task/*.d.ts"
    },
    "#training/*": {
      "@disco/source": "./src/training/*.ts",
      "default": "./dist/training/*.js",
      "types": "./dist/training/*.d.ts"
    },
    "#utils/*": {
      "@disco/source": "./src/utils/*.ts",
      "default": "./dist/utils/*.js",
      "types": "./dist/utils/*.d.ts"
    },
    "#weights/*": {
      "@disco/source": "./src/weights/*.ts",
      "default": "./dist/weights/*.js",
      "types": "./dist/weights/*.d.ts"
    }
  },
  "homepage": "https://github.com/epfml/disco#readme",
  "dependencies": {
    "@epfml/isomorphic-wrtc": "workspace:*",
    "@jimp/core": "1.6.1",
    "@jimp/plugin-resize": "1.6.1",
    "@msgpack/msgpack": "3.1.3",
    "@tensorflow/tfjs": "catalog:",
    "@xenova/transformers": "2.17.2",
    "chalk": "4.1.2",
    "debug": "catalog:",
    "fast-check": "3.23.2",
    "immutable": "catalog:",
    "isomorphic-ws": "5.0.0",
    "simple-peer": "9.11.1",
    "ws": "8.21.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/simple-peer": "9.11.9",
    "nodemon": "3.1.14",
    "vitest": "catalog:"
  }
}
