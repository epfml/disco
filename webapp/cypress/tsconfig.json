{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["./e2e/**/*", "./support/**/*"],
  "references": [
    {
      "path": "../../discojs/tsconfig.lib.json"
    },
    {
      "path": "../../discojs-web/tsconfig.lib.json"
    }
  ],
  "compilerOptions": {
    "isolatedModules": false,
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "types": ["cypress"],

    // for importing support files
    "allowImportingTsExtensions": true
  }
}
