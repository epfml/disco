{
  "name": "webapp",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "vue-tsc --build && vite build",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "vitest --run",
    "test:e2e": "VITE_SERVER_URL=http://server start-server-and-test \"pnpm start\" http://localhost:1351 'pnpm exec cypress run --e2e'",
    "test:e2e-interactive": "VITE_SERVER_URL=http://server start-server-and-test \"pnpm start\" http://localhost:1351 'pnpm exec cypress open --e2e'"
  },
  "dependencies": {
    "@epfml/discojs": "workspace:",
    "@epfml/discojs-web": "workspace:",
    "@msgpack/msgpack": "3.1.3",
    "@tensorflow/tfjs": "catalog:",
    "chart.js": "4.5.1",
    "cypress": "15.17.0",
    "d3": "7.9.0",
    "debug": "catalog:",
    "driver.js": "1.4.0",
    "immutable": "catalog:",
    "pinia": "3.0.4",
    "pinia-plugin-persistedstate-2": "2.0.32",
    "tippy.js": "6.3.7",
    "vee-validate": "5.0.0-beta.0",
    "vue": "3.5.34",
    "vue-chartjs": "5.3.3",
    "vue-router": "5.1.0",
    "vue-tippy": "6.7.1",
    "vue-toast-notification": "3.1.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@pinia/testing": "1.0.3",
    "@tailwindcss/vite": "4.3.1",
    "@tsconfig/node20": "20.1.9",
    "@types/d3": "7.4.3",
    "@types/jsdom": "28.0.0",
    "@vitejs/plugin-vue": "6.0.7",
    "@vue/test-utils": "2.4.6",
    "@vue/tsconfig": "0.9.1",
    "buffer": "6.0.3",
    "canvas": "3.2.3",
    "jsdom": "29.0.1",
    "start-server-and-test": "3.0.4",
    "tailwindcss": "4.3.1",
    "typescript": "catalog:",
    "vite": "8.0.16",
    "vitest": "catalog:",
    "vue-tsc": "3.3.9",
    "vue3-spinners": "1.3.3"
  }
