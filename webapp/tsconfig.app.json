{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  "exclude": ["src/**/__tests__/*"],
  "references": [
    {
      "path": "../discojs"
    },
    {
      "path": "../discojs-web"
    }
  ],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "tsconfig.app.tsbuildinfo",

    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
