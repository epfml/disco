{
  "composite": true,
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,

    "module": "node16",
    "target": "es2022",

    "strict": true,

    // tfjs and others
    "skipLibCheck": true,

    // don't pollute
    "noEmitOnError": true,

    // enforce using the override keyword
    "noImplicitOverride": true
  }
}
