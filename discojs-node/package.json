  },
  "homepage": "https://github.com/epfml/disco#readme",
  "dependencies": {
    "@epfml/discojs": "workspace:",
    "csv-parse": "6.2.0",
    "debug": "catalog:",
    "node-fetch": "2.7.0",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@types/node-fetch": "2.6.13",
    "nodemon": "3.1.14",
    "tmp-promise": "3.0.3",
    "vitest": "catalog:"
  }
